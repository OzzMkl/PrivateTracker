<?xml version="1.0" encoding="utf-8"?>
<!--
    From 0.4 the protocol runs over TLS only, so no host may be reached in the clear. Servers have
    self-signed certificates that trackers trust by the pinned key alone (core:network's
    PinnedKeyTrustManager); the system anchors here serve everything else, such as map tiles.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
