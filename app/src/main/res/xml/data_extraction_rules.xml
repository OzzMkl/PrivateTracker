<?xml version="1.0" encoding="utf-8"?>
<!--
    Location history must never reach a third-party cloud: databases and DataStore files are
    excluded from cloud backup. Direct device-to-device transfer keeps them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <!--
        The device id stays behind on a transfer: its signing key lives in the Keystore and never moves,
        so a copied id would be refused by the server (KEY_MISMATCH). The new phone gets a fresh id and key.
    -->
    <device-transfer>
        <exclude domain="file" path="datastore/identity.json" />
        <!-- The server's encryption keys are wrapped by a Keystore key that stays behind, so they would not open. -->
        <exclude domain="file" path="datastore/server_encryption_keys.json" />
    </device-transfer>
</data-extraction-rules>
